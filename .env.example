# apps/api
PORT=8787
DATABASE_URL=                  # empty = embedded PGlite in ./.data (local only)
SESSION_SECRET=                # 32+ random bytes, hex
WEB_ORIGIN=http://localhost:3000
# Optional extra web origins (comma-separated) that can start GitHub sign-in; register each callback on the GitHub app
WEB_ORIGINS_EXTRA=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b  # verified 2026-10-02: tool calling + JSON
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b           # verified 2026-10-02: input_type query/passage, 2048 dims
NVIDIA_CHAT_EXTRA_JSON={"chat_template_kwargs":{"enable_thinking":false}}
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEW_AGENT_ID=
ELEVENLABS_VERIFY_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TOOL_SECRET=        # shared secret header for agent server-tools
ELEVENLABS_STT_MODEL=scribe_v1 # confirm current Scribe model id
INTERVIEW_MAX_SECONDS=180      # hard cap per interview (free tier)
RPC_URL=https://sepolia.base.org
RELAYER_PRIVATE_KEY=           # throwaway testnet key ONLY (deployer + MINTER)
ADMIN_ADDRESS=                 # your own wallet; SBT admin (revoke), must differ from relayer
BASESCAN_API_KEY=              # optional, contract verification
SBT_ADDRESS=
EAS_ADDRESS=
EAS_SCHEMA_REGISTRY_ADDRESS=
EAS_SCHEMA_REVIEW_UID=
EAS_SCHEMA_INTERVIEW_UID=
MAX_GAS_PRICE_GWEI=5           # relayer refuses to send above this

# apps/web
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SBT_ADDRESS=
API_INTERNAL_URL=http://localhost:8787   # used by next.config rewrites
