{
  "name": "@karma/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p .",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.3",
    "@karma/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "hono": "4.13.12",
    "openai": "7.25.0",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "unpdf": "1.8.1",
    "viem": "2.57.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.3"
  }
}
